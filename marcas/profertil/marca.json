      "definicion": "Documento prearmado y editable con elementos de marca ya aplicados."
    },
    {
      "termino": "Versión monocromática",
      "definicion": "Logo en un solo color, utilizado sobre fondos con bajo contraste o fotografías."
    },
    {
      "termino": "Sans serif",
      "definicion": "Tipografía sin remates. Ejemplo: Familjen Grotesk, DM Sans."
    },
    {
      "termino": "Jerarquía visual",
      "definicion": "Organización de elementos según importancia, usando tamaño, peso y posición para guiar la lectura."
    },
    {
      "termino": "Interlineado",
      "definicion": "Espacio vertical entre líneas de texto. Se mide en porcentaje (ej: 130%)."
