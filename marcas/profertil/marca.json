  "glosario": [
    {
      "termino": "Logotipo",
      "definicion": "El nombre \"Profertil\" completo, incluyendo símbolo y texto."
    },
    {
      "termino": "Área de exclusión",
      "definicion": "Espacio mínimo que debe rodear al logo, libre de otros elementos."
    },
    {
      "termino": "Paleta de color",
      "definicion": "Conjunto definido de colores permitidos para usar en comunicaciones de marca."
    },
    {
      "termino": "Contraste",
      "definicion": "Diferencia visual entre colores que garantiza legibilidad. Se mide en ratios (4.5:1, 7:1)."
    },
    {
      "termino": "WCAG",
      "definicion": "Web Content Accessibility Guidelines. Estándares internacionales de accesibilidad digital."
    },
    {
      "termino": "HEX",
      "definicion": "Código de color para web. Ejemplo: #003DA5."
    },
    {
      "termino": "RGB",
      "definicion": "Sistema de color para pantallas (Red, Green, Blue)."
    },
    {
      "termino": "CMYK",
      "definicion": "Sistema de color para impresión (Cyan, Magenta, Yellow, Black)."
    },
    {
      "termino": "Pantone",
      "definicion": "Sistema de color estandarizado para impresión."
    },
    {
      "termino": "Formato vectorial",
      "definicion": "Archivo de imagen basado en fórmulas matemáticas que permite escalarse sin perder calidad."
    },
    {
      "termino": "Sistema modular",
      "definicion": "Elementos visuales que se pueden combinar de múltiples formas manteniendo coherencia."
    },
    {
      "termino": "Submarca",
      "definicion": "Marca dependiente de la marca madre. Ejemplo: eNeTOTAL PLUS es submarca de Profertil."
    },
    {
      "termino": "Sistema visual",
      "definicion": "Conjunto de elementos gráficos que complementan el logo y crean coherencia visual."
    },
    {
      "termino": "Iconografía",
      "definicion": "Biblioteca de íconos del sistema, organizados por categorías de negocio."
    },
    {
      "termino": "Cobranding",
      "definicion": "Cuando aparecen dos o más marcas juntas."
    },
    {
      "termino": "Arquitectura de marca",
      "definicion": "Organización y relación jerárquica entre la marca madre y sus submarcas o productos."
